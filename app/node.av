module Node
    intent =
        "The commands that make this program a node rather than a downloader."
        "A downloader is told a range and stops at the end of it; a node is"
        "told nothing and never stops. Held apart from the adapter that"
        "dispatches everything else because it is the half that grows with the"
        "full-node plan -- one Peer at first, a pool of them since Stage 5,"
        "inbound ones since Stage 8 -- and the adapter should not grow with it."
    exposes [Plan, follow, planned, claimedFor, openedFor, afterRun]
    depends [Infra.Peers, App.Usage, Domain.Address, Domain.Network, Infra.Blocks, Infra.Follow, Infra.Lock, Infra.Screen, Infra.Store]
    effects [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.listen, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.showCursor,
        Time.unixMs,
        Wait.poll,
    ]

fn follow(network: Network, rest: List<String>) -> Result<Unit, String>
    ? "follow with nothing after it: the usage, and nothing run. Every other"
      "follow is a Plan that main runs as processes (planned)."
    ! [Console.print]
    Result.Ok(App.Usage.print())

record Plan
    network: Network
    addresses: List<PeerAddress>
    dir: String
    screened: Bool
    answering: Option<Int>
    logging: Option<String>
    boarding: Option<Int>
    inbound: Option<String>

fn planned(network: Network, rest: List<String>) -> Option<Result<Plan, String>>
    ? "Stay on the tip of the Network until the process is stopped: the"
      "arguments as a Plan, or nothing when follow was given none and only"
      "prints its usage. A Peer and a directory; neither has a sensible"
      "default."
    match rest
        [] -> Option.None
        [address, ..more] -> Option.Some(plannedWith(network, address, more))

verify planned
    planned(Network.Regtest, []) => Option.None
    Option.withDefault(planned(Network.Regtest, ["chain"]), Result.Err("no")) => Result.Ok(Plan(network = Network.Regtest, addresses = [], dir = "chain", screened = false, answering = Option.None, logging = Option.None, boarding = Option.None, inbound = Option.None))

fn plannedWith(network: Network, address: String, more: List<String>) -> Result<Plan, String>
    ? "follow <dir> asks the DNS seeds; follow <peers> <dir> names them."
    match keywordOnly(more)
        true -> Result.Ok(Plan(network = network, addresses = [], dir = address, screened = screenAsked(more), answering = servePort(more, network), logging = logPath(more, address), boarding = boardPort(more), inbound = inboundSaid(more)))
        false -> namedPlan(network, address, more)

verify plannedWith
    plannedWith(Network.Regtest, "nonsense", ["chain"]) => Result.Err("expected four dot-separated octets, got 1")

fn namedPlan(network: Network, address: String, more: List<String>) -> Result<Plan, String>
    ? "Peers were named, so only those are dialled -- a regtest or a"
      "controlled test never depends on DNS (#166)."
    match more
        [] -> Result.Err("follow needs a directory after the Peers it names")
        [dir, ..extra] -> plannedPeers(network, addressesIn(network, String.split(address, ","), []), dir, extra)

verify namedPlan
    namedPlan(Network.Regtest, "127.0.0.1", []) => Result.Err("follow needs a directory after the Peers it names")

fn plannedPeers(network: Network, addresses: Result<List<PeerAddress>, String>, dir: String, extra: List<String>) -> Result<Plan, String>
    ? "The Plan, or why an address was rejected."
    match addresses
        Result.Err(message) -> Result.Err(message)
        Result.Ok(peers) -> Result.Ok(Plan(network = network, addresses = peers, dir = dir, screened = screenAsked(extra), answering = servePort(extra, network), logging = logPath(extra, dir), boarding = boardPort(extra), inbound = inboundSaid(extra)))

verify plannedPeers
    plannedPeers(Network.Regtest, Result.Err("no"), "chain", []) => Result.Err("no")

fn claimedFor(given: Option<Result<Plan, String>>) -> Option<Result<Plan, String>>
    ? "Take the directory for the life of the process."
      "A follower holds the claim until it stops, which is the point: the"
      "Index, the Segments and the UTXO Set are all being written as Blocks"
      "arrive, and a prune or a second follower running beside it would be"
      "writing the same keys from a different idea of where the tip is."
      "The stop flag is read once here before anything long begins, because"
      "reading it is what installs the SIGINT/SIGTERM handler: without this a"
      "Ctrl-C during the header catch-up would kill the process before the"
      "loop ever polled, and the claim would be left behind (#112)."
      "The inbound cap is read here too, so a bad one is refused before the"
      "node opens anything. Nothing is claimed for a command that is not"
      "follow, which is None and goes to the CLI."
    ! [Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText, Process.stopRequested]
    match given
        Option.None -> Option.None
        Option.Some(parsed) -> Option.Some(claimedPlan(parsed))

fn claimedPlan(parsed: Result<Plan, String>) -> Result<Plan, String>
    ? "A Plan claimed, or the reason it cannot be, in the words the CLI uses."
    ! [Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText, Process.stopRequested]
    match parsed
        Result.Err(message) -> Result.Err("error: {message}")
        Result.Ok(plan) -> claimingFor(plan, Infra.Lock.claim(plan.dir, "follow"))

fn claimingFor(plan: Plan, claimed: Result<Unit, String>) -> Result<Plan, String>
    ? "The claim taken and the stop handler installed, then the cap read."
    ! [Disk.delete, Process.stopRequested]
    match claimed
        Result.Err(why) -> Result.Err("error: {why}")
        Result.Ok(_) -> armed(plan, Process.stopRequested(), Infra.Peers.inboundCapFrom(plan.inbound))

fn armed(plan: Plan, stopArmed: Bool, cap: Result<Int, String>) -> Result<Plan, String>
    ? "A cap that will not parse gives the claim back and says why."
    ! [Disk.delete]
    match cap
        Result.Err(why) -> releasedWith(plan.dir, "error: {why}")
        Result.Ok(_) -> Result.Ok(plan)

fn releasedWith(dir: String, why: String) -> Result<Plan, String>
    ? "The claim given back, and the reason handed on."
    ! [Disk.delete]
    _released = Infra.Lock.release(dir)
    Result.Err(why)

fn openedFor(plan: Plan) -> Result<Following, String>
    ? "Open everything the three phases write to, then the node itself."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.listen, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor,
        Time.unixMs,
        Wait.poll,
    ]
    store = Infra.Store.open(plan.dir)?
    blocks = Infra.Blocks.open(blocksPath(plan.dir))?
    cap = Infra.Peers.inboundCapFrom(plan.inbound)?
    Infra.Follow.opened(plan.network, plan.addresses, store, blocks, plan.screened, plan.answering, plan.logging, notePath(plan.logging, plan.dir), plan.boarding, cap)

fn afterRun(plan: Plan, ran: Result<Unit, String>) -> Result<Unit, String>
    ? "The loop has returned: the claim given back, the terminal restored"
      "if the Screen had it, and the run reported the way every command"
      "reports -- stopped following, or the reason it could not go on."
    ! [Console.print, Disk.delete, Terminal.disableRawMode, Terminal.flush, Terminal.showCursor]
    _released = Infra.Lock.release(plan.dir)
    _given = restoredIf(plan.screened)
    said(outcomeOf(ran))

fn restoredIf(screened: Bool) -> Unit
    ? "Give the terminal back if the Screen ever had it; restoring twice is harmless."
    ! [Terminal.disableRawMode, Terminal.flush, Terminal.showCursor]
    match screened
        true -> Infra.Screen.restored()
        false -> Unit

fn outcomeOf(ran: Result<Unit, String>) -> Result<String, String>
    ? "The reason the run failed, or a clean stop."
    match ran
        Result.Err(why) -> Result.Err(why)
        Result.Ok(_) -> Result.Ok("stopped following")

verify outcomeOf
    outcomeOf(Result.Ok(Unit)) => Result.Ok("stopped following")
    outcomeOf(Result.Err("no")) => Result.Err("no")

fn keywordOnly(more: List<String>) -> Bool
    ? "Whether what follows the first argument is only words, which is how"
      "follow <dir> is told apart from follow <peer-addresses> <dir> (#166)."
      "Arity plus two reserved words settles it: nothing after the directory,"
      "or nothing but screen and serve. A directory actually named screen"
      "would be read as the word, which is a price worth paying for a"
      "grammar with no flag in it."
    match more
        [] -> true
        [head, ..tail] -> keywordThenRest(head, tail)

verify keywordOnly
    keywordOnly([]) => true
    keywordOnly(["screen"]) => true
    keywordOnly(["serve"]) => true
    keywordOnly(["serve:18455"]) => true
    keywordOnly(["screen", "serve"]) => true
    keywordOnly(["/tmp/chain"]) => false
    keywordOnly(["/tmp/chain", "screen"]) => false

fn keywordThenRest(head: String, tail: List<String>) -> Bool
    ? "This word, then the rest of them."
    match isKeyword(head)
        false -> false
        true -> keywordOnly(tail)

verify keywordThenRest
    keywordThenRest("screen", []) => true
    keywordThenRest("/tmp/chain", []) => false

fn isKeyword(word: String) -> Bool
    ? "The words that are not a directory: screen, serve, serve:PORT, log"
      "and log:PATH."
    Bool.or(word == "screen", Bool.or(word == "log", Bool.or(String.startsWith(word, "log:"), Bool.or(word == "serve", Bool.or(String.startsWith(word, "serve:"), Bool.or(word == "http", Bool.or(String.startsWith(word, "http:"), String.startsWith(word, "inbound:"))))))))

verify isKeyword
    isKeyword("screen") => true
    isKeyword("serve") => true
    isKeyword("serve:18455") => true
    isKeyword("log") => true
    isKeyword("log:/tmp/m.log") => true
    isKeyword("/tmp/chain") => false
    isKeyword("http") => true
    isKeyword("http:8331") => true
    isKeyword("served") => false
    isKeyword("logs") => false

fn notePath(logging: Option<String>, dir: String) -> Option<String>
    ? "Where the debug log goes: beside the chain it describes, whenever a"
      "metrics log was asked for (#218)."
      "The same word turns both on, because the two answer the same question"
      "at different resolutions -- metrics.log says a phase went wrong and"
      "debug.log says which decision did -- and a fault found in one is read"
      "in the other. It stays in the directory even when log:PATH sends the"
      "metrics elsewhere: it is about this chain directory's run, and a"
      "reader who has the directory has the log."
    match logging
        Option.None -> Option.None
        Option.Some(path) -> Option.Some("{dir}/debug.log")

verify notePath
    notePath(Option.None, "/d") => Option.None
    notePath(Option.Some("/d/metrics.log"), "/d") => Option.Some("/d/debug.log")
    notePath(Option.Some("/tmp/m.log"), "/d") => Option.Some("/d/debug.log")

fn logPath(extra: List<String>, dir: String) -> Option<String>
    ? "Where the metrics log goes, if the word log was given (#180)."
      "A word rather than a default, like serve: a run that writes a file"
      "somebody did not ask for is a surprise, and this one grows for as long"
      "as the run lasts."
      "log alone puts metrics.log inside the directory being built, which is"
      "where it belongs -- it describes that directory's construction."
      "log:PATH names somewhere else, for a reader who wants it off the disk"
      "being measured."
    logPathIn(extra, "{dir}/metrics.log")

verify logPath
    logPath([], "/d") => Option.None
    logPath(["log"], "/d") => Option.Some("/d/metrics.log")
    logPath(["log:/tmp/m.log"], "/d") => Option.Some("/tmp/m.log")
    logPath(["screen", "log"], "/d") => Option.Some("/d/metrics.log")
    logPath(["screen"], "/d") => Option.None

fn logPathIn(extra: List<String>, fallback: String) -> Option<String>
    ? "The first word that asks for a log, and where it asks for it."
    match extra
        [] -> Option.None
        [head, ..tail] -> logWordOr(head, tail, fallback)

verify logPathIn
    logPathIn([], "/d/metrics.log") => Option.None
    logPathIn(["log"], "/d/metrics.log") => Option.Some("/d/metrics.log")

fn logWordOr(word: String, rest: List<String>, fallback: String) -> Option<String>
    ? "This word, or keep looking through the rest."
    match word == "log"
        true -> Option.Some(fallback)
        false -> logPathAfter(word, rest, fallback)

verify logWordOr
    logWordOr("log", [], "/d/m.log") => Option.Some("/d/m.log")
    logWordOr("screen", [], "/d/m.log") => Option.None

fn logPathAfter(word: String, rest: List<String>, fallback: String) -> Option<String>
    ? "log:PATH names the file; anything else is somebody else's word."
    match String.startsWith(word, "log:")
        true -> Option.Some(String.slice(word, 4, String.len(word)))
        false -> logPathIn(rest, fallback)

verify logPathAfter
    logPathAfter("log:/tmp/m.log", [], "/d/m.log") => Option.Some("/tmp/m.log")
    logPathAfter("screen", ["log"], "/d/m.log") => Option.Some("/d/m.log")
    logPathAfter("screen", [], "/d/m.log") => Option.None

fn inboundSaid(extra: List<String>) -> Option<String>
    ? "The number after inbound:, if the word was given (#329)."
      "A word rather than an environment variable because the cap only means"
      "anything when serve is on, and serve is already spelled here. It also"
      "keeps the read out of the program: Infra.Peers holds the cap on the"
      "Pool, so nothing in the accept path has to reach for the world."
    inboundIn(extra)

verify inboundSaid
    inboundSaid([]) => Option.None
    inboundSaid(["serve"]) => Option.None
    inboundSaid(["inbound:40"]) => Option.Some("40")
    inboundSaid(["screen", "serve", "inbound:8"]) => Option.Some("8")

fn inboundIn(extra: List<String>) -> Option<String>
    ? "The first inbound: word, if there is one."
    match extra
        [] -> Option.None
        [head, ..tail] -> inboundOrNext(head, tail)

verify inboundIn
    inboundIn([]) => Option.None
    inboundIn(["inbound:2"]) => Option.Some("2")

fn inboundOrNext(word: String, rest: List<String>) -> Option<String>
    ? "This word if it names the cap, otherwise look further."
    match String.startsWith(word, "inbound:")
        true -> Option.Some(String.slice(word, 8, String.len(word)))
        false -> inboundIn(rest)

verify inboundOrNext
    inboundOrNext("inbound:40", []) => Option.Some("40")
    inboundOrNext("serve", ["inbound:9"]) => Option.Some("9")
    inboundOrNext("serve", []) => Option.None

fn servePort(extra: List<String>, network: Network) -> Option<Int>
    ? "Which port to answer callers on, if the word serve was given (#30)."
      "A word rather than a default, because binding a port is the one thing"
      "this program does that invites strangers in, and nobody should acquire"
      "an open port by upgrading."
      "serve alone takes the Network's own port, which is what a real node"
      "wants. serve:PORT names another, which is what a second node on one"
      "machine needs -- including the regtest pair the end-to-end test uses,"
      "where Bitcoin Core already holds 18444."
    servePortIn(extra, Domain.Network.portOf(network))

verify servePort
    servePort([], Network.Regtest) => Option.None
    servePort(["serve"], Network.Regtest) => Option.Some(18444)
    servePort(["serve:18455"], Network.Regtest) => Option.Some(18455)
    servePort(["screen", "serve"], Network.Signet) => Option.Some(38333)
    servePort(["something"], Network.Regtest) => Option.None

fn servePortIn(extra: List<String>, fallback: Int) -> Option<Int>
    ? "The first word that asks to serve, and what it asks for."
    match extra
        [] -> Option.None
        [head, ..tail] -> serveWordOr(head, tail, fallback)

verify servePortIn
    servePortIn([], 18444) => Option.None
    servePortIn(["serve"], 18444) => Option.Some(18444)

fn serveWordOr(word: String, rest: List<String>, fallback: Int) -> Option<Int>
    ? "This word, or keep looking through the rest."
    match word == "serve"
        true -> Option.Some(fallback)
        false -> servePortAfter(word, rest, fallback)

verify serveWordOr
    serveWordOr("serve", [], 18444) => Option.Some(18444)
    serveWordOr("screen", [], 18444) => Option.None

fn servePortAfter(word: String, rest: List<String>, fallback: Int) -> Option<Int>
    ? "serve:PORT names its own port; anything else is not ours."
    match String.startsWith(word, "serve:")
        false -> servePortIn(rest, fallback)
        true -> portAfterColon(String.split(word, ":"), rest, fallback)

verify servePortAfter
    servePortAfter("serve:18455", [], 18444) => Option.Some(18455)
    servePortAfter("screen", [], 18444) => Option.None

fn boardPort(extra: List<String>) -> Option<Int>
    ? "Which port to put the status Board on, if the word http was given"
      "(#261): 8330 unless http:PORT names another."
    boardPortIn(extra)

verify boardPort
    boardPort([]) => Option.None
    boardPort(["http"]) => Option.Some(8330)
    boardPort(["http:8331"]) => Option.Some(8331)
    boardPort(["screen", "serve", "http:8331", "log"]) => Option.Some(8331)
    boardPort(["http:x"]) => Option.None

fn boardPortIn(extra: List<String>) -> Option<Int>
    ? "The first word that asks for the Board, and what it asks for."
    match extra
        [] -> Option.None
        [head, ..tail] -> boardWordOr(head, tail)

verify boardPortIn
    boardPortIn([]) => Option.None
    boardPortIn(["log", "http"]) => Option.Some(8330)

fn boardWordOr(word: String, rest: List<String>) -> Option<Int>
    ? "This word, or keep looking through the rest."
    match word == "http"
        true -> Option.Some(boardDefaultPort())
        false -> boardPortAfter(word, rest)

verify boardWordOr
    boardWordOr("http", []) => Option.Some(8330)
    boardWordOr("screen", ["http"]) => Option.Some(8330)

fn boardPortAfter(word: String, rest: List<String>) -> Option<Int>
    ? "http:PORT names its own port; anything else is not ours."
    match String.startsWith(word, "http:")
        false -> boardPortIn(rest)
        true -> portAfterColon(String.split(word, ":"), rest, boardDefaultPort())

verify boardPortAfter
    boardPortAfter("http:8331", []) => Option.Some(8331)
    boardPortAfter("screen", []) => Option.None

fn boardDefaultPort() -> Int
    ? "8330: beside Bitcoin's 8332 and 8333, and the same on every"
      "Network, so a signet and a mainnet on one machine name theirs."
    8330

verify boardDefaultPort
    boardDefaultPort() => 8330

fn portAfterColon(parts: List<String>, rest: List<String>, fallback: Int) -> Option<Int>
    ? "The half after the colon, which the word being serve: guarantees."
    match parts
        [] -> servePortIn(rest, fallback)
        [head, ..tail] -> portInTail(tail, rest, fallback)

verify portAfterColon
    portAfterColon(["serve", "18455"], [], 18444) => Option.Some(18455)
    portAfterColon([], [], 18444) => Option.None

fn portInTail(tail: List<String>, rest: List<String>, fallback: Int) -> Option<Int>
    ? "What follows the colon, if anything does."
    match tail
        [] -> servePortIn(rest, fallback)
        [head, ..more] -> portIn(head, rest, fallback)

verify portInTail
    portInTail(["18455"], [], 18444) => Option.Some(18455)
    portInTail([], [], 18444) => Option.None

fn portIn(text: String, rest: List<String>, fallback: Int) -> Option<Int>
    ? "A port that will not parse is not a port, and the word is passed over"
      "rather than silently becoming the default -- a typed port that binds"
      "somewhere else is worse than one that does not bind."
    match Int.fromString(text)
        Result.Err(why) -> servePortIn(rest, fallback)
        Result.Ok(port) -> Option.Some(port)

verify portIn
    portIn("18455", [], 18444) => Option.Some(18455)
    portIn("nonsense", [], 18444) => Option.None

fn screenAsked(extra: List<String>) -> Bool
    ? "Whether the word screen follows the directory (#130)."
    List.contains(extra, "screen")

verify screenAsked
    screenAsked([]) => false
    screenAsked(["screen"]) => true
    screenAsked(["something"]) => false

fn addressesIn(network: Network, texts: List<String>, acc: List<PeerAddress>) -> Result<List<PeerAddress>, String>
    ? "Every Peer named on the command line, in the order they were named."
      "Several Peers rather than one was the whole of Stage 5's first half;"
      "the Address Book fills the pool from there, but the first Peers still"
      "come from the person running it, or a DNS seed when nobody is named."
      "A comma rather than repeated arguments, so the"
      "grammar of every other command stays what it was."
    match texts
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> addressThen(network, head, tail, acc)

verify addressesIn
    List.len(addressesIn(Network.Signet, ["192.0.2.1"], [])?) => 1
    List.len(addressesIn(Network.Signet, ["192.0.2.1", "192.0.2.2"], [])?) => 2
    addressesIn(Network.Signet, [], []) => Result.Ok([])
    addressesIn(Network.Signet, ["nonsense"], []) => Result.Err("expected four dot-separated octets, got 1")

fn addressThen(network: Network, text: String, rest: List<String>, acc: List<PeerAddress>) -> Result<List<PeerAddress>, String>
    ? "One name parsed, then the rest; the first bad one stops the lot."
    match Domain.Address.fromPeerText(text, Domain.Network.portOf(network))
        Result.Err(why) -> Result.Err(why)
        Result.Ok(peer) -> addressesIn(network, rest, List.prepend(peer, acc))

verify addressThen
    List.len(addressThen(Network.Signet, "192.0.2.1", [], [])?) => 1
    addressThen(Network.Signet, "nonsense", [], []) => Result.Err("expected four dot-separated octets, got 1")

fn blocksPath(dir: String) -> String
    ? "Where the Segments live."
    "{dir}/blocks"

verify blocksPath
    blocksPath("chain") => "chain/blocks"

fn said(outcome: Result<String, String>) -> Result<Unit, String>
    ? "Report what the node finished with."
    ! [Console.print]
    match outcome
        Result.Ok(line) -> Result.Ok(Console.print(line))
        Result.Err(message) -> Result.Err("error: {message}")
