module ScriptMath
    intent =
        "What Script's arithmetic opcodes compute, and nothing else."
        "Numbers only. Taking the operands off the stack, refusing the ones that"
        "are too wide, and putting the answer back are the interpreter's, so"
        "what is left here is a pair of tables that can be read against the"
        "reference client line by line without any machinery in the way."
        "Aver has no closures, so an operation cannot be passed to a helper and"
        "these are matches on the opcode rather than functions of it. That turns"
        "out to read better anyway: the opcode number and what it does are on"
        "the same line."
        "Nothing here needs to know that Script numbers are four bytes wide."
        "Aver's Int is arbitrary precision, the operands were checked before"
        "they arrived, and every one of these but OP_ADD and OP_SUB returns"
        "something narrower than it was given."
    exposes [oneIf, unaryValue, binaryValue]
    depends []
    effects []

fn oneIf(condition: Bool) -> Int
    ? "How Script writes a true or false answer: a one or an empty item."
      "Zero here rather than an empty list because the caller encodes it, and"
      "the encoding of zero is the empty item."
    match condition
        true -> 1
        false -> 0

verify oneIf
    oneIf(true) => 1
    oneIf(false) => 0

fn unaryValue(code: Int, a: Int) -> Int
    ? "What each unary arithmetic opcode makes of its one operand."
      "OP_NOT and OP_0NOTEQUAL are in here rather than with the comparisons"
      "because they take one operand, whatever their names suggest."
    match code
        139 -> a + 1
        140 -> a - 1
        143 -> 0 - a
        144 -> absolute(a)
        145 -> oneIf(a == 0)
        146 -> oneIf(a != 0)
        _ -> a

verify unaryValue
    unaryValue(139, 1) => 2
    unaryValue(140, 1) => 0
    unaryValue(143, 1) => 0 - 1
    unaryValue(143, 0 - 1) => 1
    unaryValue(144, 0 - 5) => 5
    unaryValue(144, 5) => 5
    unaryValue(145, 0) => 1
    unaryValue(145, 7) => 0
    unaryValue(146, 5) => 1
    unaryValue(146, 0) => 0

verify unaryValue law absIsMaxOfSelfAndNegated
    given a: Int = [-2147483647, -256, -255, -128, -127, -1, 0, 1, 127, 128, 255, 256, 2147483647]
    unaryValue(144, a) => binaryValue(164, a, unaryValue(143, a))

verify unaryValue law negateIsAnInvolution
    given a: Int = [-2147483647, -256, -1, 0, 1, 255, 2147483647]
    unaryValue(143, unaryValue(143, a)) => a

verify unaryValue law notAndZeroNotEqualAreOpposites
    given a: Int = [-2147483647, -1, 0, 1, 2147483647]
    unaryValue(145, a) + unaryValue(146, a) => 1

verify unaryValue law unaryValueSpec
    given code: Int = [0, 139, 140, 143, 144, 145, 146, 147]
    given a: Int = [-2147483648, -1, 0, 1, 2147483647]
    unaryValue(code, a) => unaryValueSpec(code, a)

fn absolute(a: Int) -> Int
    ? "Size without sign."
    match a < 0
        true -> 0 - a
        false -> a

verify absolute
    absolute(0 - 5) => 5
    absolute(5) => 5
    absolute(0) => 0

fn binaryValue(code: Int, a: Int, b: Int) -> Int
    ? "What each binary arithmetic opcode makes of its two operands."
      "a was the deeper of the two on the stack and b was on top, so a"
      "subtraction is a minus b. Getting that round the wrong way is the"
      "classic mistake here and the only reason it is written down twice."
    match code
        147 -> a + b
        148 -> a - b
        154 -> oneIf(Bool.and(a != 0, b != 0))
        155 -> oneIf(Bool.or(a != 0, b != 0))
        156 -> oneIf(a == b)
        158 -> oneIf(a != b)
        159 -> oneIf(a < b)
        160 -> oneIf(a > b)
        161 -> oneIf(a <= b)
        162 -> oneIf(a >= b)
        163 -> smaller(a, b)
        164 -> larger(a, b)
        _ -> 0

verify binaryValue
    binaryValue(147, 2, 3) => 5
    binaryValue(148, 5, 3) => 2
    binaryValue(148, 3, 5) => 0 - 2
    binaryValue(154, 1, 0) => 0
    binaryValue(154, 1, 2) => 1
    binaryValue(155, 1, 0) => 1
    binaryValue(155, 0, 0) => 0
    binaryValue(156, 3, 3) => 1
    binaryValue(158, 3, 3) => 0
    binaryValue(159, 2, 3) => 1
    binaryValue(160, 2, 3) => 0
    binaryValue(161, 3, 3) => 1
    binaryValue(162, 3, 3) => 1
    binaryValue(163, 2, 3) => 2
    binaryValue(164, 2, 3) => 3

verify binaryValue law subtractionSwappedIsNegated
    given a: Int = [-2147483647, -256, -1, 0, 1, 255, 2147483647]
    given b: Int = [-2147483647, -1, 0, 1, 2147483647]
    binaryValue(148, a, b) => unaryValue(143, binaryValue(148, b, a))

verify binaryValue law lessThanMirrorsGreaterThan
    given a: Int = [-2147483647, -1, 0, 1, 2147483647]
    given b: Int = [-2147483647, -1, 0, 1, 2147483647]
    binaryValue(159, a, b) => binaryValue(160, b, a)

verify binaryValue law minAndMaxShareThePair
    given a: Int = [-2147483647, -1, 0, 1, 2147483647]
    given b: Int = [-2147483647, -1, 0, 1, 2147483647]
    binaryValue(163, a, b) + binaryValue(164, a, b) => a + b

verify binaryValue law equalAndNotEqualAreOpposites
    given a: Int = [-1, 0, 1, 2147483647]
    given b: Int = [-1, 0, 1, 2147483647]
    binaryValue(156, a, b) + binaryValue(158, a, b) => 1

verify binaryValue law binaryValueSpec
    given code: Int = [0, 147, 148, 154, 155, 156, 158, 159, 160, 161, 162, 163, 164, 165]
    given a: Int = [-2147483647, -1, 0, 1, 2147483647]
    given b: Int = [-2147483647, -1, 0, 1, 2147483647]
    binaryValue(code, a, b) => binaryValueSpec(code, a, b)

verify binaryValue law commutative
    given code: Int = [147, 154, 155, 156, 158, 163, 164]
    given a: Int = [-2147483647, -1, 0, 1, 2147483647]
    given b: Int = [-2147483647, -1, 0, 1, 2147483647]
    when List.contains([147, 154, 155, 156, 158, 163, 164], code)
    binaryValue(code, a, b) => binaryValue(code, b, a)

fn smaller(a: Int, b: Int) -> Int
    ? "OP_MIN."
    match a <= b
        true -> a
        false -> b

verify smaller
    smaller(2, 3) => 2
    smaller(3, 2) => 2

fn larger(a: Int, b: Int) -> Int
    ? "OP_MAX."
    match a >= b
        true -> a
        false -> b

verify larger
    larger(2, 3) => 3
    larger(3, 2) => 3

fn unaryValueSpec(code: Int, a: Int) -> Int
    ? "The unary table again, read line by line against Core's EvalScript."
      "OP_1ADD: bn = bn + bnOne. OP_1SUB: bn = bn - bnOne. OP_NEGATE: bn = -bn."
      "OP_ABS: if (bn < bnZero) bn = -bn. OP_NOT: bn = (bn == bnZero)."
      "OP_0NOTEQUAL: bn = (bn != bnZero). Anything else is not a unary"
      "arithmetic opcode and the operand passes through untouched."
    match code
        139 -> a + 1
        140 -> a - 1
        143 -> 0 - a
        144 -> Int.abs(a)
        145 -> match a == 0
            true -> 1
            false -> 0
        146 -> match a == 0
            true -> 0
            false -> 1
        _ -> a

verify unaryValueSpec
    unaryValueSpec(139, 1) => 2
    unaryValueSpec(144, 0 - 5) => 5
    unaryValueSpec(145, 0) => 1
    unaryValueSpec(146, 0) => 0
    unaryValueSpec(0, 9) => 9

fn binaryValueSpec(code: Int, a: Int, b: Int) -> Int
    ? "The binary table again, read line by line against Core's EvalScript,"
      "with bn1 the deeper operand and bn2 the top."
      "OP_ADD: bn = bn1 + bn2. OP_SUB: bn = bn1 - bn2."
      "OP_BOOLAND: bn = (bn1 != bnZero && bn2 != bnZero)."
      "OP_BOOLOR: bn = (bn1 != bnZero || bn2 != bnZero)."
      "OP_NUMEQUAL: bn = (bn1 == bn2). OP_NUMNOTEQUAL: bn = (bn1 != bn2)."
      "OP_LESSTHAN: bn = (bn1 < bn2). OP_GREATERTHAN: bn = (bn1 > bn2)."
      "OP_LESSTHANOREQUAL: bn = (bn1 <= bn2). OP_GREATERTHANOREQUAL: bn = (bn1 >= bn2)."
      "OP_MIN: bn = (bn1 < bn2 ? bn1 : bn2). OP_MAX: bn = (bn1 > bn2 ? bn1 : bn2)."
      "Anything else is not a binary arithmetic opcode and the table says nought."
    match code
        147 -> a + b
        148 -> a - b
        154 -> match Bool.and(a != 0, b != 0)
            true -> 1
            false -> 0
        155 -> match Bool.or(a != 0, b != 0)
            true -> 1
            false -> 0
        156 -> match a == b
            true -> 1
            false -> 0
        158 -> match a != b
            true -> 1
            false -> 0
        159 -> match a < b
            true -> 1
            false -> 0
        160 -> match a > b
            true -> 1
            false -> 0
        161 -> match a <= b
            true -> 1
            false -> 0
        162 -> match a >= b
            true -> 1
            false -> 0
        163 -> Int.min(a, b)
        164 -> Int.max(a, b)
        _ -> 0

verify binaryValueSpec
    binaryValueSpec(147, 2, 3) => 5
    binaryValueSpec(148, 3, 5) => 0 - 2
    binaryValueSpec(154, 1, 0) => 0
    binaryValueSpec(159, 2, 3) => 1
    binaryValueSpec(163, 2, 3) => 2
    binaryValueSpec(164, 2, 3) => 3
    binaryValueSpec(0, 2, 3) => 0
