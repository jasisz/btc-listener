module Preparation
    kind = capability
    semantics = effectful
    depends [Work]
    intent = "The off-turn block preparation job."
    exposes []

operation begin(task: Int) -> Result<Work.Job, String>
    ? "Begin the bounded consumer workload."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<Result<Int, String>>, String>
    ? "The result, including a decode error, once the worker finishes."
    oracle = generativeOutput
    replay = recorded
