module Board
    intent = "A bounded HTTP dashboard owner. Each reader retains its request or response cursor between turns; no client operation waits."
    depends [Bytes, Domain.Message, Domain.Page, Domain.Screen, Domain.Snapshot]
    exposes [watchSockets, Board, opened, served, closed, readersATurn, patienceMs, requestBytes]
    effects [Tcp.accept, Tcp.close, Tcp.closeListener, Tcp.listen, Tcp.readNow, Tcp.writeNow]

record Reader
    connection: Tcp.Connection
    request: Bytes
    response: Option<Bytes>
    offset: Int
    deadlineMs: Int

record Board
    listener: Tcp.Listener
    port: Int
    readers: List<Reader>

fn opened(port: Int) -> Result<Board, String>
    ? "Bind the board; pending clients are bounded independently of the listener backlog."
    ! [Tcp.listen]
    Result.Ok(Board(listener = Tcp.listen(port, 16)?, port = port, readers = []))

fn closed(board: Board) -> Unit
    ? "Release both the listener and every unfinished response."
    ! [Tcp.close, Tcp.closeListener]
    closeReaders(board.readers)
    _closed = Tcp.closeListener(board.listener)
    Unit

fn closeReaders(readers: List<Reader>) -> Unit
    ! [Tcp.close]
    match readers
        [] -> Unit
        [head, ..rest] -> closeNext(head, rest)

fn closeNext(reader: Reader, rest: List<Reader>) -> Unit
    ! [Tcp.close]
    _closed = Tcp.close(reader.connection)
    closeReaders(rest)

fn readersATurn() -> Int
    4

verify readersATurn
    readersATurn() => 4

fn patienceMs() -> Int
    5000

verify patienceMs
    patienceMs() => 5000

fn requestBytes() -> Int
    4096

verify requestBytes
    requestBytes() => 4096

fn served(board: Board, snapshot: Snapshot, nowMs: Int) -> Board
    ? "One nonblocking operation per retained reader, followed by at most four accepts; keep at most sixteen clients."
    ! [Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow]
    retained = stepped(board.readers, snapshot, nowMs, [])
    accepting(Board.update(board, readers = retained), nowMs, readersATurn())

fn accepting(board: Board, nowMs: Int, left: Int) -> Board
    ! [Tcp.accept]
    match Bool.or(left <= 0, List.len(board.readers) >= 16)
        true -> board
        false -> match Tcp.accept(board.listener)
            Result.Err(why) -> board
            Result.Ok(found) -> match found
                Option.None -> board
                Option.Some(connection) -> accepting(Board.update(board, readers = List.concat(board.readers, [Reader(connection = connection, request = Bytes.empty(), response = Option.None, offset = 0, deadlineMs = nowMs + patienceMs())])), nowMs, left - 1)

fn stepped(readers: List<Reader>, snapshot: Snapshot, nowMs: Int, acc: List<Reader>) -> List<Reader>
    ! [Tcp.close, Tcp.readNow, Tcp.writeNow]
    match readers
        [] -> List.reverse(acc)
        [head, ..rest] -> match step(head, snapshot, nowMs)
            Option.None -> stepped(rest, snapshot, nowMs, acc)
            Option.Some(next) -> stepped(rest, snapshot, nowMs, List.prepend(next, acc))

fn dropped(reader: Reader) -> Option<Reader>
    ! [Tcp.close]
    _closed = Tcp.close(reader.connection)
    Option.None

fn step(reader: Reader, snapshot: Snapshot, nowMs: Int) -> Option<Reader>
    ? "One absolute deadline bounds request trickles and clients that never read a response."
    ! [Tcp.close, Tcp.readNow, Tcp.writeNow]
    match nowMs >= reader.deadlineMs
        true -> dropped(reader)
        false -> match reader.response
            Option.Some(bytes) -> sending(reader, bytes)
            Option.None -> receiving(reader, snapshot, nowMs)

fn sending(reader: Reader, bytes: Bytes) -> Option<Reader>
    ! [Tcp.close, Tcp.writeNow]
    match Tcp.writeNow(reader.connection, Bytes.take(Bytes.drop(bytes, reader.offset), 65536))
        Result.Err(why) -> dropped(reader)
        Result.Ok(count) -> match reader.offset + count >= Bytes.len(bytes)
            true -> dropped(reader)
            false -> Option.Some(Reader.update(reader, offset = reader.offset + count))

fn receiving(reader: Reader, snapshot: Snapshot, nowMs: Int) -> Option<Reader>
    ! [Tcp.close, Tcp.readNow]
    match Tcp.readNow(reader.connection, requestBytes() - Bytes.len(reader.request))
        Result.Err(why) -> dropped(reader)
        Result.Ok(found) -> match found
            Option.None -> Option.Some(reader)
            Option.Some(bytes) -> match Bytes.len(bytes) == 0
                true -> dropped(reader)
                false -> received(Reader.update(reader, request = Bytes.concat(reader.request, bytes)), snapshot, nowMs)

fn received(reader: Reader, snapshot: Snapshot, nowMs: Int) -> Option<Reader>
    ! [Tcp.close]
    text = Domain.Message.asciiText(Bytes.octets(reader.request))
    match String.contains(text, "\r\n\r\n")
        true -> prepared(reader, Domain.Page.answerTo(text, Domain.Screen.pageSections(snapshot, nowMs)))
        false -> match Bytes.len(reader.request) >= requestBytes()
            true -> dropped(reader)
            false -> Option.Some(reader)

fn prepared(reader: Reader, response: String) -> Option<Reader>
    ! [Tcp.close]
    match Bytes.fromList(Domain.Message.asciiBytes(response))
        Result.Err(why) -> dropped(reader)
        Result.Ok(bytes) -> Option.Some(Reader.update(reader, response = Option.Some(bytes), request = Bytes.empty()))

fn watchSockets(board: Board) -> Map<Int, Tcp.Socket>
    ? "Only retained readers enter the shared wait; acceptance runs every bounded owner turn, so a full board cannot spin on its backlog."
    watchReaders(board.readers, 1, {})

fn watchReaders(readers: List<Reader>, key: Int, sockets: Map<Int, Tcp.Socket>) -> Map<Int, Tcp.Socket>
    match readers
        [] -> sockets
        [head, ..rest] -> match head.response
            Option.None -> watchReaders(rest, key + 1, Map.set(sockets, key, Tcp.Socket.Connected(head.connection)))
            Option.Some(bytes) -> watchReaders(rest, key + 1, Map.set(sockets, key, Tcp.Socket.Sending(head.connection)))

verify watchReaders
    Map.len(watchReaders([], 1, {})) => 0
