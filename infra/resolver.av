module Resolver
    intent =
        "Finding a Peer to talk to, when none was named on the command line."
        "Bitcoin publishes seed hostnames that answer with the addresses of"
        "reachable Peers. The question and the answer are built and read in"
        "Domain.Dns; this module only carries them over a socket."
        "DNS over TCP puts a two-byte length in front of the message, which"
        "makes the exchange exactly the shape exact-length reads are for: read"
        "two bytes to learn the size, then read precisely that many."
    exposes [lookupAt, discover, discoverAll, seedsOf, resolverHost]
    depends [Infra.Readiness, Bytes, Domain.Dns, Domain.Address, Domain.Network]
    effects [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]

fn resolverHost() -> String
    ? "The recursive resolver the seed question is put to."
    "1.1.1.1"

verify resolverHost
    resolverHost() => "1.1.1.1"

fn resolverPort() -> Int
    ? "DNS listens on port 53, over TCP as well as UDP."
    53

verify resolverPort
    resolverPort() => 53

fn seedsOf(network: Network) -> List<String>
    ? "The seed hostnames Bitcoin Core ships with, for each Network that has any."
    match network
        Network.Mainnet -> mainnetSeeds()
        Network.Testnet -> ["testnet-seed.bitcoin.jonasschnelli.ch", "seed.tbtc.petertodd.net", "seed.testnet.bitcoin.sprovoost.nl", "testnet-seed.bluematt.me"]
        Network.Signet -> ["seed.signet.bitcoin.sprovoost.nl", "seed.signet.achownodes.xyz"]
        Network.Regtest -> []

verify seedsOf
    List.len(seedsOf(Network.Mainnet)) => 8
    List.contains(seedsOf(Network.Mainnet), "seed.bitcoin.sipa.be") => true
    seedsOf(Network.Signet) => ["seed.signet.bitcoin.sprovoost.nl", "seed.signet.achownodes.xyz"]
    seedsOf(Network.Regtest) => []
    seedsOf(Network.Testnet) => ["testnet-seed.bitcoin.jonasschnelli.ch", "seed.tbtc.petertodd.net", "seed.testnet.bitcoin.sprovoost.nl", "testnet-seed.bluematt.me"]

fn mainnetSeeds() -> List<String>
    ? "The mainnet list, in its own function only for length."
    [
        "seed.bitcoin.sipa.be",
        "dnsseed.bluematt.me",
        "seed.bitcoinstats.com",
        "seed.bitcoin.jonasschnelli.ch",
        "seed.btc.petertodd.net",
        "seed.bitcoin.sprovoost.nl",
        "dnsseed.emzy.de",
        "seed.bitcoin.wiz.biz",
    ]

verify mainnetSeeds
    List.len(mainnetSeeds()) => 8

fn discover(network: Network) -> Result<PeerAddress, String>
    ? "Ask a randomly chosen seed for Peers, and pick one of its answers."
      "A Network with no seeds is an answer, not a lookup that fails."
      "One address is what the bare listener wants: one question to one"
      "server, one Peer to listen to. A node that means to keep company"
      "wants the whole answer, which is discoverAll."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match seedsOf(network)
        [] -> Result.Err("the {Domain.Network.nameOf(network)} Network has no DNS seeds")
        [head, ..rest] -> chooseAddress(lookup(pick(List.prepend(head, rest), head))?, Domain.Network.portOf(network))

fn discoverAll(network: Network) -> Result<List<PeerAddress>, String>
    ? "Every address a seed answered with, for a node that wants company"
      "rather than a Peer (#166)."
      "Seeds are tried in a random order and the first that answers with"
      "anything is taken. A seed that answers nothing is not a failure --"
      "it is a seed having a bad day -- so the next one is asked, and only"
      "running out of seeds is an error."
      "One seed's answer skews towards one operator's view of the Network."
      "That is worth knowing and is not fixed here: n1bor/btc-listener#118"
      "is where eclipse resistance belongs, and until it lands the Address"
      "Book is a convenience rather than a defence."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match seedsOf(network)
        [] -> Result.Err("the {Domain.Network.nameOf(network)} Network has no DNS seeds")
        [head, ..rest] -> askingSeeds(shuffled(List.prepend(head, rest), []), network, [])

fn askingSeeds(seeds: List<String>, network: Network, tried: List<String>) -> Result<List<PeerAddress>, String>
    ? "Each seed in turn, until one answers with addresses."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match seeds
        [] -> Result.Err("no DNS seed for the {Domain.Network.nameOf(network)} Network answered with an address; tried {List.len(tried)}")
        [head, ..rest] -> askedSeed(head, rest, network, tried)

fn askedSeed(seed: String, rest: List<String>, network: Network, tried: List<String>) -> Result<List<PeerAddress>, String>
    ? "One seed asked. A lookup that fails outright is the same as one that"
      "answers nothing: try the next."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _active = active(Time.unixMs() + answerDeadlineMs())?
    gave = lookup(seed)
    match gave
        Result.Err(why) -> askingSeeds(rest, network, List.prepend(seed, tried))
        Result.Ok(octets) -> seedAnswered(octets, seed, rest, network, tried)

fn seedAnswered(octets: List<List<Int>>, seed: String, rest: List<String>, network: Network, tried: List<String>) -> Result<List<PeerAddress>, String>
    ? "An empty answer sends us to the next seed; anything else is what we"
      "came for."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match octets
        [] -> askingSeeds(rest, network, List.prepend(seed, tried))
        [head, ..tail] -> addressesOn(octets, Domain.Network.portOf(network), [])

fn addressesOn(octets: List<List<Int>>, port: Int, acc: List<PeerAddress>) -> Result<List<PeerAddress>, String>
    ? "Each set of octets as an Address on the Network's port."
    match octets
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> addressesOn(tail, port, List.prepend(Domain.Address.fromOctetsOn(head, port)?, acc))

verify addressesOn
    addressesOn([], 8333, []) => Result.Ok([])
    List.len(Result.withDefault(addressesOn([[1, 2, 3, 4]], 8333, []), [])) => 1
    List.len(Result.withDefault(addressesOn([[1, 2, 3, 4], [5, 6, 7, 8]], 8333, []), [])) => 2

fn shuffled(seeds: List<String>, acc: List<String>) -> List<String>
    ? "The seeds in a random order, so one operator is not always asked"
      "first."
    ! [Random.int]
    match seeds
        [] -> List.reverse(acc)
        [head, ..tail] -> takenOut(List.prepend(head, tail), acc)

fn takenOut(seeds: List<String>, acc: List<String>) -> List<String>
    ? "One seed drawn at random, then the rest of them."
    ! [Random.int]
    drawnAt(seeds, chosenIndex(seeds), acc)

fn chosenIndex(seeds: List<String>) -> Int
    ? "Which one to draw. A roll nobody could make is the first."
    ! [Random.int]
    Result.withDefault(Random.int(0, List.len(seeds) - 1), 0)

fn drawnAt(seeds: List<String>, index: Int, acc: List<String>) -> List<String>
    ? "The seed at that position moved across, and the others carried on."
    ! [Random.int]
    shuffled(withoutAt(seeds, index, 0, []), List.prepend(itemAt(seeds, index, ""), acc))

fn withoutAt(seeds: List<String>, index: Int, at: Int, acc: List<String>) -> List<String>
    ? "Every seed but the one at that position."
    match seeds
        [] -> List.reverse(acc)
        [head, ..tail] -> keptUnless(head, tail, index, at, acc)

verify withoutAt
    withoutAt(["a", "b", "c"], 1, 0, []) => ["a", "c"]
    withoutAt(["a"], 0, 0, []) => []
    withoutAt([], 0, 0, []) => []

fn keptUnless(head: String, tail: List<String>, index: Int, at: Int, acc: List<String>) -> List<String>
    ? "This one, unless it is the one being drawn."
    match at == index
        true -> withoutAt(tail, index, at + 1, acc)
        false -> withoutAt(tail, index, at + 1, List.prepend(head, acc))

verify keptUnless
    keptUnless("a", [], 0, 0, []) => []
    keptUnless("a", [], 1, 0, []) => ["a"]

fn pick(candidates: List<String>, fallback: String) -> String
    ? "One of the candidates, chosen at random."
    ! [Random.int]
    chosen(candidates, Random.int(0, List.len(candidates) - 1), fallback)

fn chosen(candidates: List<String>, roll: Result<Int, String>, fallback: String) -> String
    ? "A roll nobody could make is a list with nothing in it to choose from."
      "Random.int over a computed range answers a Result since"
      "jasisz/aver#1109, and the only way this range is invalid is an empty"
      "list -- its upper bound is one less than the length. Both callers have"
      "already matched a non-empty list, so this cannot happen; naming what it"
      "would mean is cheaper than asserting that it will not."
    match roll
        Result.Err(why) -> fallback
        Result.Ok(index) -> itemAt(candidates, index, fallback)

verify chosen
    chosen(["a", "b"], Result.Ok(1), "z") => "b"
    chosen([], Result.Err("empty range"), "z") => "z"

fn itemAt(candidates: List<String>, index: Int, fallback: String) -> String
    ? "The candidate at this position, or the fallback if there is none."
    Option.withDefault(Vector.get(Vector.fromList(candidates), index), fallback)

verify itemAt
    itemAt(["a", "b"], 1, "z") => "b"
    itemAt([], 0, "z") => "z"

fn chooseAddress(addresses: List<List<Int>>, port: Int) -> Result<PeerAddress, String>
    ? "One of the returned addresses, chosen at random, on the Network's port."
    ! [Random.int]
    match addresses
        [] -> Result.Err("the seed returned no addresses")
        [head, ..tail] -> Domain.Address.fromOctetsOn(octetsChosen(addresses, Random.int(0, List.len(addresses) - 1), head), port)

fn octetsChosen(addresses: List<List<Int>>, roll: Result<Int, String>, fallback: List<Int>) -> List<Int>
    ? "The same, for the addresses a seed answered with."
    match roll
        Result.Err(why) -> fallback
        Result.Ok(index) -> octetsAt(addresses, index, fallback)

verify octetsChosen
    octetsChosen([[1], [2]], Result.Ok(1), [9]) => [2]
    octetsChosen([], Result.Err("empty range"), [9]) => [9]

fn octetsAt(addresses: List<List<Int>>, index: Int, fallback: List<Int>) -> List<Int>
    ? "The address at this position, or the first if there is none."
    Option.withDefault(Vector.get(Vector.fromList(addresses), index), fallback)

verify octetsAt
    octetsAt([[1], [2]], 1, [9]) => [2]
    octetsAt([], 0, [9]) => [9]

fn lookup(name: String) -> Result<List<List<Int>>, String>
    ? "A stop-aware DNS exchange with one absolute deadline, including dial and partial writes. Used during discovery when no peer is available."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    lookupAt(name, resolverHost(), resolverPort())

fn lookupAt(name: String, host: String, port: Int) -> Result<List<List<Int>>, String>
    ? "Resolve through an explicitly named TCP resolver, using the same bounded exchange as seed discovery."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    deadlineMs = Time.unixMs() + answerDeadlineMs()
    dial = Tcp.beginConnect(host, port)?
    connection = connected(dial, deadlineMs)
    _released = Tcp.closeDial(dial)
    match connection
        Result.Err(why) -> Result.Err(why)
        Result.Ok(one) -> closeAfter(one, exchange(one, name, deadlineMs))

fn connected(dial: Tcp.Dial, deadlineMs: Int) -> Result<Tcp.Connection, String>
    ? "Retry only after a bounded wait and a stop/deadline check."
    ! [Process.stopRequested, Tcp.dialled, Time.unixMs, Wait.poll]
    _active = active(deadlineMs)?
    match Tcp.dialled(dial)
        Result.Err(why) -> Result.Err(why)
        Result.Ok(found) -> match found
            Option.Some(connection) -> Result.Ok(connection)
            Option.None -> connectLater(dial, deadlineMs)

fn connectLater(dial: Tcp.Dial, deadlineMs: Int) -> Result<Tcp.Connection, String>
    ! [Process.stopRequested, Tcp.dialled, Time.unixMs, Wait.poll]
    _ready = Wait.poll({0 => Wait.Item.Socket(Tcp.Socket.Dialing(dial))}, 100)?
    connected(dial, deadlineMs)

fn active(deadlineMs: Int) -> Result<Unit, String>
    ! [Process.stopRequested, Time.unixMs]
    match Process.stopRequested()
        true -> Result.Err("DNS discovery stopped")
        false -> match Time.unixMs() >= deadlineMs
            true -> Result.Err("DNS exchange deadline expired")
            false -> Result.Ok(Unit)

fn closeAfter(connection: Tcp.Connection, answer: Result<List<List<Int>>, String>) -> Result<List<List<Int>>, String>
    ? "Always release the socket, whatever the exchange did."
    ! [Tcp.close]
    _closed = Tcp.close(connection)
    answer

fn exchange(connection: Tcp.Connection, name: String, deadlineMs: Int) -> Result<List<List<Int>>, String>
    ? "Retain the exact write offset and fragmented length-prefixed answer across bounded waits."
    ! [
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    question = Domain.Dns.question(name, Random.int(0, 65535))?
    framed = Bytes.fromList(List.concat(lengthPrefix(Bytes.len(question)), Bytes.octets(question)))?
    _sent = writing(connection, framed, 0, deadlineMs)?
    answerBytes(connection, Bytes.empty(), deadlineMs)

fn writing(connection: Tcp.Connection, bytes: Bytes, offset: Int, deadlineMs: Int) -> Result<Unit, String>
    ! [
        Process.stopRequested,
        Tcp.beginConnect, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _active = active(deadlineMs)?
    match offset >= Bytes.len(bytes)
        true -> Result.Ok(Unit)
        false -> writtenSome(connection, bytes, offset, deadlineMs, Tcp.writeNow(connection, Bytes.drop(bytes, offset))?)

fn writtenSome(connection: Tcp.Connection, bytes: Bytes, offset: Int, deadlineMs: Int, count: Int) -> Result<Unit, String>
    ! [
        Process.stopRequested,
        Tcp.beginConnect, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _ready = Wait.poll({0 => Wait.Item.Socket(Tcp.Socket.Sending(connection))}, 100)?
    writing(connection, bytes, offset + count, deadlineMs)

fn answerBytes(connection: Tcp.Connection, bytes: Bytes, deadlineMs: Int) -> Result<List<List<Int>>, String>
    ! [
        Process.stopRequested,
        Tcp.beginConnect, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _active = active(deadlineMs)?
    match completeAnswer(bytes)
        Option.Some(body) -> Result.Ok(Domain.Dns.addressesOf(Bytes.octets(body)))
        Option.None -> readingAnswer(connection, bytes, deadlineMs)

fn completeAnswer(bytes: Bytes) -> Option<Bytes>
    ? "A partial prefix or body is not a response; the two-byte prefix bounds retained memory to 65537 bytes."
    match Bytes.len(bytes) >= 2
        false -> Option.None
        true -> completeBody(bytes, sizeOf(Bytes.octets(Bytes.take(bytes, 2))))

verify completeAnswer
    completeAnswer(Bytes.fromList([0])) => Option.None
    completeAnswer(Bytes.fromList([0, 2, 7])) => Option.None
    completeAnswer(Bytes.fromList([0, 2, 7, 8])) => Option.Some(Bytes.fromList([7, 8]))

fn completeBody(bytes: Bytes, size: Int) -> Option<Bytes>
    match Bytes.len(bytes) >= size + 2
        true -> Option.Some(Bytes.take(Bytes.drop(bytes, 2), size))
        false -> Option.None

verify completeBody
    completeBody(Bytes.fromList([0, 2, 7]), 2) => Option.None
    completeBody(Bytes.fromList([0, 2, 7, 8, 9]), 2) => Option.Some(Bytes.fromList([7, 8]))

fn readingAnswer(connection: Tcp.Connection, bytes: Bytes, deadlineMs: Int) -> Result<List<List<Int>>, String>
    ! [
        Process.stopRequested,
        Tcp.beginConnect, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _ready = Wait.poll({0 => Wait.Item.Socket(Tcp.Socket.Connected(connection))}, 100)?
    match Tcp.readNow(connection, 65537 - Bytes.len(bytes))
        Result.Err(why) -> Result.Err(why)
        Result.Ok(found) -> match found
            Option.None -> answerBytes(connection, bytes, deadlineMs)
            Option.Some(arrived) -> match Bytes.len(arrived) == 0
                true -> Result.Err("DNS connection closed before its complete answer")
                false -> answerBytes(connection, Bytes.concat(bytes, arrived), deadlineMs)

fn lengthPrefix(size: Int) -> List<Int>
    ? "DNS over TCP puts the message size in two big-endian bytes."
    [Int.div(size, 256), Int.mod(size, 256)]

verify lengthPrefix
    lengthPrefix(38) => [0, 38]
    lengthPrefix(300) => [1, 44]

fn answered(ready: Bool) -> Result<Unit, String>
    ? "Whether the resolver had anything to say before the deadline."
    match ready
        true -> Result.Ok(Unit)
        false -> Result.Err("the resolver said nothing for {Int.div(answerDeadlineMs(), 1000)} seconds")

verify answered
    answered(true) => Result.Ok(Unit)
    answered(false) => Result.Err("the resolver said nothing for 15 seconds")

fn answerDeadlineMs() -> Int
    ? "How long the resolver's answer is waited for."
      "Far shorter than Infra.Peer's idle deadline: a Peer may honestly have"
      "nothing to say for minutes, but a resolver asked a question either"
      "answers promptly or is not going to."
    15000

verify answerDeadlineMs
    answerDeadlineMs() => 15000

fn sizeOf(prefix: List<Int>) -> Int
    ? "The announced message size, read from its two big-endian bytes."
    match prefix
        [] -> 0
        [head, ..tail] -> head * 256 + Option.withDefault(Vector.get(Vector.fromList(tail), 0), 0)

verify sizeOf
    sizeOf([0, 38]) => 38
    sizeOf([1, 44]) => 300
    sizeOf([]) => 0
